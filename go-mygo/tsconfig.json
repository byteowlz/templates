{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "third_party/design-system/src"
  ]
}
